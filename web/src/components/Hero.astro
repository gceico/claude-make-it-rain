---
import Install from "./Install.astro";

// Hero: wordmark, tagline, the "Today <date>" + "resets in <countdown>" pills,
// and today's COLLECTIVE tally — the whole community's combined spend, with a
// tangible equivalence — instead of a single top spender. The date, countdown,
// tally and equivalence values are populated client-side.
---

<header class="mb-[clamp(28px,5vh,44px)] text-center">
  <h1
    class="m-0 font-display text-[clamp(2.2rem,8.5vw,4.6rem)] leading-[0.96] font-extrabold tracking-[0.005em] uppercase [text-wrap:balance]"
  >
    <span
      class="mr-[0.12em] text-[0.82em] [filter:drop-shadow(0_3px_8px_#ffd23f4d)] select-none"
      >💸</span
    > Make It Rain
  </h1>
  <p
    class="mx-auto mt-3 max-w-[50ch] text-[clamp(1rem,2.4vw,1.15rem)] leading-relaxed text-muted-strong [text-wrap:balance]"
  >
    Every dollar your AI coding agents burn, made impossible to ignore.
  </p>
  <div class="tally" id="tally">
    <div class="amt" id="tallyAmt">$0.00</div>
    <p class="cap">
      Burned together today by <b id="tallyCount">0</b>
      <span id="tallyNoun"> builders</span>.
    </p>
    <p class="tally-meta" id="collectiveMeta"></p>
  </div>

    <div class="mt-4 flex flex-wrap justify-center gap-1">
    <div class="datepill">
      <span class="dot"></span> Today <span class="date" id="date">…</span>
    </div>
    <div class="datepill reset">
      <span class="dot"></span> Resets in <span class="date" id="countdown"
        >…</span
      >
    </div>

    <Install />
  </div>
</header>
