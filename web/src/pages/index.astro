---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Graph from '../components/Graph.astro';
import Reflection from '../components/Reflection.astro';
import Leaderboard from '../components/Leaderboard.astro';
---

<Layout>
  <main
    class="relative z-10 mx-auto max-w-[660px] px-[clamp(16px,5vw,24px)] pt-[clamp(64px,12vh,120px)] pb-6"
  >
    <Hero />
    <Reflection />
    <Graph />
    <Leaderboard />
  </main>
</Layout>

<script>
  // Client entry: seeds the money rain, wires the countdown, and fetches the
  // live star count + leaderboard (same-origin, fail-silent). Astro bundles this
  // to a hashed module under /_astro/ and loads it with `type="module"` (deferred).
  import { init } from '../lib/leaderboard';
  init();
</script>
